# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# From your client_secret.json file:
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# From running get-refresh-token.js:
GOOGLE_REFRESH_TOKEN=your-refresh-token

# A password you make up yourself — Bulga will need to send this
# with every request. Make it long and random.
API_KEY=choose-a-long-random-string-here

# Railway sets this automatically; only needed for local testing
PORT=3000
